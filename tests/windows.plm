// expect: ok
scene Windows {
    surface { size: 600, 400; kind: window; title: "windows" }
    windows win max 3
    repeat i in 0..3 {
        prop x.$i = 0 ~lively
        follow x.$i = max(win.$i.place, 0) * 200
        window win.$i { at: x.$i, 0; size: 200, 400; ask: 200, 400; opacity: win.$i.hover * 0.2 + 0.8; show: win.$i.open }
        on press win.$i { focus win.$i }
    }
    text "{win.count} · {win.socket} · {win.0.title}" { at: 10, 10; size: 11; color: #fff }
    on key Alt+Return { launch "kitty" }
    on key Alt+q { close win(win.focus) }
    on key Alt+m { promote win(win.order.1) }
    on key Alt+s { send win(win.focus) to 1 - pick(win.focus, win.0.screen, win.1.screen, win.2.screen) }
    on key Alt+x { swap win(win.focus) with win(win.order.0) }
    on key Alt+f { fullscreen win(win.focus) }
    on key Alt+n { minimize win(win.focus) }
    on key Alt+r { restore win.0 }
    box { from: 0, 0; size: 10, 10; color: #fff; show: win.1.minimized }
    box { from: 0, 0; size: 600 * win.0.fullscreen, 400; color: #000; show: win.0.fullscreen }
    window win.2 { at: 200, 100; size: win.2.width, win.2.height; ask: 0, 0; show: win.2.dialog }
    text "{win.on.0} here, {win.on.1} there" { at: 10, 30; size: 11; color: #fff }
    box { from: win.reserved.0.left, win.reserved.0.top; size: 10, 10; color: #fff }
}
