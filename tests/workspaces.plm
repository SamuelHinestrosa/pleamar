// expect: ok
// Workspaces in the compositor inside a scene: which one each window is on,
// which one each monitor shows, and the effects that change them; the pools,
// by identity, and a whole one carried to another monitor.
scene Workspaces {
    surface { size: 400, 300 }
    windows win max 4
    event go
    event send_to
    on go(v) { workspace v }
    on send_to(v) while win.focus >= 0 { send win(win.focus) to workspace v }
    on key Alt+o while win.focus >= 0 { send win(win.focus) to workspace 2 on 1 }
    on key Alt+w { workspace 2 on 0 }
    on key Alt+m { send workspace win.shown.0 on 0 to 1 }
    on key Alt+n { send workspace 1 to 1 }
    on key Alt+d { dock 0 on 0 }
    let docked = win.docks.0 + win.dock.0.0.windows + win.dock.0.0.focused + win.dock.0.0.pinned + win.dock.0.0.away + win.mins.0 + win.0.dockat + win.0.minat
    let pools = win.pools.0 + win.used.0 + win.pool.0
    repeat i in 0..4 {
        let shown = win.$i.pool == win.pool.0 and win.$i.workspace == win.shown.0
        window win.$i { at: 10 + 90 * win.$i.place, 10; size: 80, 80; show: win.$i.open and shown and win.$i.rank >= 0 and win.$i.among > 0 }
    }
}
